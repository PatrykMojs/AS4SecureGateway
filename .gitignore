*.compressed
*.gz

# =========================================================
# Samples
# =========================================================

# Certyfikaty w samples nie powinny trafiać do repo
samples/certificates/*
!samples/certificates/.gitkeep

# Wygenerowane wyjścia testowe
samples/output/*
!samples/output/.gitkeep

# Lokalne wejścia testowe — opcjonalnie ignorowane
samples/input/*
!samples/input/.gitkeep

# Jeżeli chcesz mieć przykładowy XML w repo, ten plik zostaje dozwolony
!samples/example-message.xml

# =========================================================
# Documentation generated files
# =========================================================
docs/screenshots/*.tmp
docs/screenshots/*.log
docs/diagrams/*.tmp
docs/diagrams/*.log

