{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "profiles": {
    "AS4SecureGateway.TestEndpoint": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7060;http://localhost:5060",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  },
  "Certificates": {
    "Local": {
      "PublicSignatureCertificatePath": "samples/certificates/server/server-signature-public.pem",
      "PrivateSignatureCertificatePath": "samples/certificates/server/server-signature-private.pem",
      "PublicEncryptionCertificatePath": "samples/certificates/server/server-encryption-public.pem",
      "PrivateEncryptionCertificatePath": "samples/certificates/server/server-encryption-private.pem"
    },
    "Remote": {
      "PublicSignatureCertificatePath": "samples/certificates/client/client-signature-public.pem",
      "PublicEncryptionCertificatePath": "samples/certificates/client/client-encryption-public.pem"
    }
  }
}
